        </mxCell>
        <mxCell id="MySQL" value="&lt;div style=&quot;text-align:center;padding:4px 8px;&quot;&gt;&lt;div&gt;«database»&lt;/div&gt;&lt;div style=&quot;font-weight:700;&quot;&gt;MySQL&lt;/div&gt;&lt;/div&gt;&lt;hr style=&quot;margin:0;border:none;border-top:1px solid #000&quot;&gt;&lt;div style=&quot;text-align:left;padding:4px 8px;font-family:Courier New,monospace;font-size:11px&quot;&gt;&lt;div&gt;3FN • InnoDB • UTF-8&lt;/div&gt;&lt;div&gt;PK / FK / UNIQUE / CHECK&lt;/div&gt;&lt;/div&gt;&lt;hr style=&quot;margin:0;border:none;border-top:1px solid #000&quot;&gt;&lt;div style=&quot;text-align:left;padding:4px 8px;font-family:Courier New,monospace;font-size:11px&quot;&gt;&lt;div&gt;&amp;nbsp;&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=0;overflow=fill;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.2;fontSize=11;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="2220" y="2440" width="220" height="120" as="geometry" />
        </mxCell>
        <mxCell id="arquitetura-n5" value="&lt;b&gt;Arquitetura em 3 níveis (Mauro Nunes)&lt;/b&gt;&lt;br&gt;«user interface» só captura eventos e apresenta dados.&lt;br&gt;«control» aplica regras de negócio e as transações T1–T15.&lt;br&gt;«data connection» é o único nível que executa SQL (PreparedStatement).&lt;br&gt;Dependências apenas no sentido Nível 1 → 2 → 3." style="shape=note;whiteSpace=wrap;html=1;size=16;align=left;verticalAlign=top;spacing=8;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="3520" width="560" height="150" as="geometry" />
        </mxCell>
        <mxCell id="arquitetura-n6" value="&lt;b&gt;Transações atómicas&lt;/b&gt;&lt;br&gt;T1, T2, T4, T5, T7, T8, T10, T11, T12, T13, T14 e T15 alteram várias tabelas: executam via TransactionManager.executarEmTransacao() com autoCommit=false → commit | rollback.&lt;br&gt;T3, T6 e T9 são operações de tabela única/consulta." style="shape=note;whiteSpace=wrap;html=1;size=16;align=left;verticalAlign=top;spacing=8;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="640" y="3520" width="560" height="150" as="geometry" />
        </mxCell>
        <mxCell id="arquitetura-n7" value="&lt;b&gt;Segurança&lt;/b&gt;&lt;br&gt;Credenciais JDBC vêm de ficheiro de configuração externo (Properties).&lt;br&gt;Senhas de funcionários guardadas como hash.&lt;br&gt;Toda a entrada da UI é validada no nível «control»." style="shape=note;whiteSpace=wrap;html=1;size=16;align=left;verticalAlign=top;spacing=8;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1240" y="3520" width="520" height="150" as="geometry" />
        </mxCell>
        <mxCell id="arquitetura-e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=diamondThin;startFill=1;startSize=16;endArrow=none;strokeColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="MainFrame" target="DashboardPanel">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="arquitetura-e8-s" value="1" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="arquitetura-e8">
