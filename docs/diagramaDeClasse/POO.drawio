        <mxCell id="ConnectionFactory" value="&lt;div style=&quot;text-align:center;padding:4px 8px;&quot;&gt;&lt;div&gt;«data connection»&lt;/div&gt;&lt;div style=&quot;font-weight:700;&quot;&gt;ConnectionFactory&lt;/div&gt;&lt;div style=&quot;font-size:10px&quot;&gt;{Singleton}&lt;/div&gt;&lt;/div&gt;&lt;hr style=&quot;margin:0;border:none;border-top:1px solid #000&quot;&gt;&lt;div style=&quot;text-align:left;padding:4px 8px;font-family:Courier New,monospace;font-size:11px&quot;&gt;&lt;div&gt;&lt;u&gt;-instancia: ConnectionFactory&lt;/u&gt;&lt;/div&gt;&lt;div&gt;-url: String&lt;/div&gt;&lt;div&gt;-utilizador: String&lt;/div&gt;&lt;div&gt;-senha: String&lt;/div&gt;&lt;div&gt;&lt;u&gt;-DRIVER: String = &quot;com.mysql.cj.jdbc.Driver&quot; {readOnly}&lt;/u&gt;&lt;/div&gt;&lt;/div&gt;&lt;hr style=&quot;margin:0;border:none;border-top:1px solid #000&quot;&gt;&lt;div style=&quot;text-align:left;padding:4px 8px;font-family:Courier New,monospace;font-size:11px&quot;&gt;&lt;div&gt;+ConnectionFactory()&lt;/div&gt;&lt;div&gt;+ConnectionFactory(url: String, utilizador: String, senha: String)&lt;/div&gt;&lt;div&gt;+getUrl(): String&lt;/div&gt;&lt;div&gt;+setUrl(url: String): void&lt;/div&gt;&lt;div&gt;+getUtilizador(): String&lt;/div&gt;&lt;div&gt;+setUtilizador(utilizador: String): void&lt;/div&gt;&lt;div&gt;+getSenha(): String&lt;/div&gt;&lt;div&gt;+setSenha(senha: String): void&lt;/div&gt;&lt;div&gt;&lt;u&gt;+getInstancia(): ConnectionFactory&lt;/u&gt;&lt;/div&gt;&lt;div&gt;+carregarConfiguracao(config: Properties): void&lt;/div&gt;&lt;div&gt;+obterConexao(): Connection&lt;/div&gt;&lt;div&gt;+fechar(conexao: Connection): void&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=0;overflow=fill;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.2;fontSize=11;fontColor=#000000;" vertex="1" parent="1">
