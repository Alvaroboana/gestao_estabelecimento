        <mxCell id="TransactionManager" value="&lt;div style=&quot;text-align:center;padding:4px 8px;&quot;&gt;&lt;div&gt;«data connection»&lt;/div&gt;&lt;div style=&quot;font-weight:700;&quot;&gt;TransactionManager&lt;/div&gt;&lt;/div&gt;&lt;hr style=&quot;margin:0;border:none;border-top:1px solid #000&quot;&gt;&lt;div style=&quot;text-align:left;padding:4px 8px;font-family:Courier New,monospace;font-size:11px&quot;&gt;&lt;div&gt;-connectionFactory: ConnectionFactory&lt;/div&gt;&lt;div&gt;-conexaoAtual: Connection {readOnly}&lt;/div&gt;&lt;/div&gt;&lt;hr style=&quot;margin:0;border:none;border-top:1px solid #000&quot;&gt;&lt;div style=&quot;text-align:left;padding:4px 8px;font-family:Courier New,monospace;font-size:11px&quot;&gt;&lt;div&gt;+TransactionManager()&lt;/div&gt;&lt;div&gt;+TransactionManager(connectionFactory: ConnectionFactory)&lt;/div&gt;&lt;div&gt;+getConnectionFactory(): ConnectionFactory&lt;/div&gt;&lt;div&gt;+setConnectionFactory(connectionFactory: ConnectionFactory): void&lt;/div&gt;&lt;div&gt;+getConexaoAtual(): Connection&lt;/div&gt;&lt;div&gt;+executarEmTransacao(operacao: TransactionCallback&amp;lt;T&amp;gt;): T&lt;/div&gt;&lt;div&gt;+iniciar(): void&lt;/div&gt;&lt;div&gt;+confirmar(): void&lt;/div&gt;&lt;div&gt;+reverter(): void&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=0;overflow=fill;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.2;fontSize=11;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="1190" y="2440" width="460" height="260" as="geometry" />
