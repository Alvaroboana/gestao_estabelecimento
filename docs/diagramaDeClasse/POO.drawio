        <mxCell id="TransactionCallback" value="&lt;div style=&quot;text-align:center;padding:4px 8px;&quot;&gt;&lt;div&gt;«interface»&lt;/div&gt;&lt;div style=&quot;font-weight:700;&quot;&gt;TransactionCallback&amp;lt;T&amp;gt;&lt;/div&gt;&lt;/div&gt;&lt;hr style=&quot;margin:0;border:none;border-top:1px solid #000&quot;&gt;&lt;div style=&quot;text-align:left;padding:4px 8px;font-family:Courier New,monospace;font-size:11px&quot;&gt;&lt;div&gt;&amp;nbsp;&lt;/div&gt;&lt;/div&gt;&lt;hr style=&quot;margin:0;border:none;border-top:1px solid #000&quot;&gt;&lt;div style=&quot;text-align:left;padding:4px 8px;font-family:Courier New,monospace;font-size:11px&quot;&gt;&lt;div&gt;&lt;i&gt;+executar(conexao: Connection): T&lt;/i&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=0;overflow=fill;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.2;fontSize=11;fontColor=#000000;" vertex="1" parent="1">
